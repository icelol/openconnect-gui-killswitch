+void openconnect_set_password_auth_only(struct openconnect_info *vpninfo, unsigned val)
+{
+	vpninfo->no_external_auth = !!val;
+}
+
+int openconnect_set_tls12_only(struct openconnect_info *vpninfo, unsigned val)
+{
+#ifdef OPENCONNECT_GNUTLS
+	vpninfo->ocgui_tls12_only = !!val;
+	free(vpninfo->ciphersuite_config);
+	vpninfo->ciphersuite_config = NULL;
+	return 0;
+#else
+	return val ? -EOPNOTSUPP : 0;
+#endif
+}
+
 void openconnect_set_pfs(struct openconnect_info *vpninfo, unsigned val)
 {
 	vpninfo->pfs = val;
