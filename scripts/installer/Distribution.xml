<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>OpenConnect v1.1.0 — установка и удаление</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="always" require-scripts="true"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <choices-outline>
        <line choice="install"/>
        <line choice="remove"/>
    </choices-outline>
    <!-- A single editable checkbox selects removal. Installation always has
         the inverse selection, so the two scripts cannot run together. -->
    <choice id="install" title="Установить OpenConnect" enabled="false"
            selected="!choices.remove.selected"
            description="Установить клиент. При первой установке kill switch выключен; обычная сеть остаётся доступной.">
        <pkg-ref id="net.openconnect-vpn.gui.killswitch"/>
    </choice>
    <choice id="remove" title="Полностью очистить OpenConnect"
            start_selected="false"
            description="Снять собственную блокировку, удалить службы, приложение, настройки, кэши и журналы; тестовые копии перенести в Корзину. Cisco AnyConnect и другие VPN-клиенты сохраняются.">
        <pkg-ref id="net.openconnect-vpn.gui.killswitch.remove"/>
    </choice>
    <pkg-ref id="net.openconnect-vpn.gui.killswitch" version="1.1.0" onConclusion="none">Install.pkg</pkg-ref>
    <pkg-ref id="net.openconnect-vpn.gui.killswitch.remove" version="1.1.0" onConclusion="none">Remove.pkg</pkg-ref>
</installer-gui-script>
